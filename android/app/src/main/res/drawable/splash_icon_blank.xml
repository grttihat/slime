<?xml version="1.0" encoding="utf-8"?>
<!-- 1dp transparent square used as the Android 12+ splash icon so the
     system's SplashScreen API draws NO logo — only the background
     colour defined on AppTheme.NoActionBarLaunch. Fully transparent so
     the splash reads as a plain black field with the text already baked
     into drawable/splash.png (the window background). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
